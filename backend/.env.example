# =====================================================
#  Backend Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit .env to Git!
# =====================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
# Get this from: cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/landregistry?retryWrites=true&w=majority

# --- JWT ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# --- Blockchain ---
# For local Hardhat node:
RPC_URL=http://127.0.0.1:8545
# For Sepolia:
# RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Number of block confirmations to wait before saving events (use 1 for local, 2-3 for testnet)
BLOCK_CONFIRMATIONS=1
# Which block to start syncing from (0 = from deployment block)
START_BLOCK=0

# --- Pinata IPFS ---
# Get these from: app.pinata.cloud → API Keys
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

