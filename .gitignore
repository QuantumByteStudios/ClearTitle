# ==============================================================================
# Git Ignore for Land Ownership Registry System (Monorepo: Contracts, Backend, Frontend)
# ==============================================================================

# ── Dependencies ──
node_modules/
*/node_modules/
.pnp
.pnp.js

# ── Environment Variables & Secrets (CRITICAL: Never commit keys or passwords) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
contracts/.env
frontend/.env
frontend/.env.local
!*.env.example

# ── Smart Contracts / Hardhat Build Artifacts ──
contracts/artifacts/
contracts/cache/
contracts/typechain/
contracts/typechain-types/
coverage/
coverage.json
.hardhat/

# ── Frontend Build Outputs (Vite) ──
frontend/dist/
frontend/dist-ssr/
*.local

# ── Backend Uploads & Temporary Storage ──
backend/uploads/*
!backend/uploads/.gitkeep
backend/temp/
backend/tmp/

# ── Logs & Debugging ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Operating System & File System ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── IDE & Code Editors ──
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

